class Solution {
public:
    int minSumOfLengths(vector<int>& arr, int target) {
       int currSum=0;
       int n=arr.size();
       vector<int>minLengthTillIdx(n,INT_MAX);
       int result=INT_MAX;
       int bestmin=INT_MAX;

       int i=0;
       for(int j=0;j<n;j++){
        currSum+=arr[j];
        while(currSum>target){
            currSum-=arr[i];
            i++;
        }
        if(currSum==target){
            int len=j-i+1;
            if(i>0 && minLengthTillIdx[i-1]!=INT_MAX){
                result=min(result,(len+minLengthTillIdx[i-1]));
            }
            bestmin=min(bestmin,len);
        }
        
        minLengthTillIdx[j]=bestmin;
       }
       if(result==INT_MAX){
        return -1;
       }
       return result;
    }
};
